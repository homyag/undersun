{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{% static 'core/sitemap.xsl' %}"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for sitemap in sitemaps %}
    <sitemap>
        <loc>{{ sitemap.loc }}</loc>
        {% if sitemap.lastmod %}<lastmod>{{ sitemap.lastmod }}</lastmod>{% endif %}
    </sitemap>
    {% endfor %}
</sitemapindex>
