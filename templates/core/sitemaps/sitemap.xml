{% load static %}<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{% static 'core/sitemap.xsl' %}"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
    {% for entry in entries %}
    <url>
        <loc>{{ entry.loc }}</loc>
        {% if entry.lastmod %}<lastmod>{{ entry.lastmod }}</lastmod>{% endif %}
        {% for alt in entry.alternates %}
        <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url }}" />
        {% endfor %}
        {% for image in entry.images %}
        <image:image>
            <image:loc>{{ image.loc }}</image:loc>
        </image:image>
        {% endfor %}
    </url>
    {% endfor %}
</urlset>
